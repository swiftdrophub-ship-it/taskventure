# TaskVenture production configuration — set these as secrets in your host, never commit .env.
NODE_ENV=production
# Railway supplies PORT automatically. Use 4173 only for a local production-like check.
PORT=4173
HOST=0.0.0.0
PUBLIC_APP_URL=https://app.example.com
SESSION_SECRET=replace-with-a-random-32-plus-character-secret
COOKIE_SECURE=true
TRUST_PROXY=true
TASKVENTURE_DB_FILE=/persistent-volume/taskventure.db

# Resend transactional email (required in production)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=TaskVenture <accounts@example.com>
